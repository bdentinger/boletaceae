[Wed Sep  3 12:44:26 2025]
rule align_locus:
    input: data/qc/TEF1.dedup.fasta
    output: data/align/TEF1.aln.fasta
    log: logs/mafft/TEF1.log
    jobid: 18
    reason: Missing output files: data/align/TEF1.aln.fasta; Code has changed since last execution; Params have changed since last execution
    wildcards: locus=TEF1
    resources: tmpdir=/tmp


        set -euo pipefail
        mkdir -p data/align logs/mafft

        LOCUS="TEF1"
        LUP=$(echo "$LOCUS" | tr '[:lower:]' '[:upper:]')

        if [[ " RPB1 RPB2 TEF1 " == *" ${LUP} "* ]]; then
            # CODING: MACSE (codon-aware, NT output)
            java -jar /home/bdentinger/macse_v2.07.jar -prog alignSequences \
                  -seq data/qc/TEF1.dedup.fasta \
                  -out_NT data/align/TEF1.aln.fasta \
                  -out_AA data/align/TEF1.aa.aln.fasta \
                  -gc_def 1
        else
            # NON-CODING: MAFFT
            tmp_aln=$(mktemp)
            mafft --thread 16 \
                  --anysymbol --adjustdirectionaccurately \
                  --retree 2 --maxiterate 0 \
                  "data/qc/TEF1.dedup.fasta" > "$tmp_aln" 2> "logs/mafft/TEF1.log"

            # sanity: all sequences same length and non-empty
            python3.11 - <<'PY' "$tmp_aln" "data/align/TEF1.aln.fasta"
import sys
from Bio import SeqIO
aln_in, outp = sys.argv[1], sys.argv[2]
recs = list(SeqIO.parse(aln_in, "fasta"))
if not recs:
    raise SystemExit(3)
lengths = set(len(r.seq) for r in recs)
if len(lengths) != 1 or next(iter(lengths)) == 0:
    raise SystemExit(4)
SeqIO.write(recs, outp, "fasta")
PY
        fi
        

[Wed Sep  3 12:44:27 2025]
rule merge_custom:
    input: data/qc/ITS.cleaned.fasta
    output: data/qc/ITS.merged.fasta
    jobid: 28
    reason: Missing output files: data/qc/ITS.merged.fasta; Updated input files: data/qc/ITS.cleaned.fasta
    wildcards: locus=ITS
    resources: tmpdir=/tmp


        set -euo pipefail
        mkdir -p data/qc

        PRESERVE_FLAG=""
        if [[ "false" == "true" || "false" == "1" || "false" == "yes" ]]; then
          PRESERVE_FLAG="--preserve-labels"
        fi

        if [[ -s "data/custom/sequences/ITS.fasta" ]]; then
          python3.11 workflow/scripts/ingest_custom_fasta.py \
            --in "data/custom/sequences/ITS.fasta" \
            --locus "ITS" \
            --out "data/qc/ITS.custom.ingested.fasta" \
            --taxon-map-append "data/staging/taxon_map.tsv" \
            $PRESERVE_FLAG
          cat "data/qc/ITS.cleaned.fasta" "data/qc/ITS.custom.ingested.fasta" > "data/qc/ITS.merged.fasta"
        else
          cp "data/qc/ITS.cleaned.fasta" "data/qc/ITS.merged.fasta"
        fi
        

