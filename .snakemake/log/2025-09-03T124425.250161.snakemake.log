rule dedupe_locus:
    input: data/qc/ITS.merged.fasta
    output: data/qc/ITS.dedup.fasta
    jobid: 27
    reason: Missing output files: data/qc/ITS.dedup.fasta; Input files updated by another job: data/qc/ITS.merged.fasta
    wildcards: locus=ITS
    resources: tmpdir=/tmp


        awk 'BEGIN{FS=""} /^>/{
            if (h) { print h"\n"seq; } h=$0; seq="";
        } !/^>/{ seq=seq$0; } END{ if (h) print h"\n"seq; }' data/qc/ITS.merged.fasta \
        | awk 'BEGIN{RS=">"; ORS="";} NR>1{split($0,a,"\n"); h=a[1]; gsub("\r","",h); sub("\n.*","",h); seq=""; for(i=2;i<=NF;i++) seq=seq a[i]"\n"; len=length(gensub("\n","", "g", seq)); if (len>max[h]){buf[h]=seq; max[h]=len;}} END{for (k in buf) print ">"k"\n"buf[k];}' \
        > data/qc/ITS.dedup.fasta
        
