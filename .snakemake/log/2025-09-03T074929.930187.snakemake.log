rule align_locus:
    input: data/qc/RPB1.dedup.fasta
    output: data/align/RPB1.aln.fasta
    log: logs/mafft/RPB1.log
    jobid: 0
    reason: Missing output files: data/align/RPB1.aln.fasta
    wildcards: locus=RPB1
    resources: tmpdir=/tmp


        set -euo pipefail
        mkdir -p data/align logs/mafft

        LOCUS="RPB1"
        LUP=$(echo "$LOCUS" | tr '[:lower:]' '[:upper:]')

        if [[ " RPB1 RPB2 TEF1 " == *" ${LUP} "* ]]; then
            # CODING: MACSE (codon-aware, NT output)
            java -jar /home/bdentinger/macse_v2.07.jar -prog alignSequences \
                  -seq data/qc/RPB1.dedup.fasta \
                  -out_NT data/align/RPB1.aln.fasta \
                  -out_AA data/align/RPB1.aa.aln.fasta \
                  -gc_def 1
        else
            # NON-CODING: MAFFT
            tmp_aln=$(mktemp)
            mafft --thread 16 \
                  --anysymbol --adjustdirectionaccurately \
                  --retree 2 --maxiterate 0 \
                  "data/qc/RPB1.dedup.fasta" > "$tmp_aln" 2> "logs/mafft/RPB1.log"

            # sanity: all sequences same length and non-empty
            python3.11 - <<'PY' "$tmp_aln" "data/align/RPB1.aln.fasta"
import sys
from Bio import SeqIO
aln_in, outp = sys.argv[1], sys.argv[2]
recs = list(SeqIO.parse(aln_in, "fasta"))
if not recs:
    raise SystemExit(3)
lengths = set(len(r.seq) for r in recs)
if len(lengths) != 1 or next(iter(lengths)) == 0:
    raise SystemExit(4)
SeqIO.write(recs, outp, "fasta")
PY
        fi
        
